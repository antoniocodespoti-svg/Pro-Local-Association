# Esempio di configurazione per PostgreSQL - Pro-Local Backend
# NON inserire password o credenziali reali in questo file.
# Copiare in .env per lo sviluppo locale: cp .env.example .env

# Ambiente di esecuzione (development, test, production)
NODE_ENV=development

# Porta del server HTTP
PORT=3001

# Modalità di persistenza: 'memory' oppure 'postgres'
DB_DRIVER=memory

# Connessione PostgreSQL (usata solo se DB_DRIVER=postgres)
DATABASE_URL=postgresql://postgres:postgres_local_dev_password@localhost:5432/prolocal_dev

# Oppure parametri disaggregati equivalenti
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres_local_dev_password
# PGDATABASE=prolocal_dev
# PGSSL=false
