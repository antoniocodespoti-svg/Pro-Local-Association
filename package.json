{
  "name": "pro-local-root",
  "private": true,
  "type": "module",
  "scripts": {
    "test:backend": "node --experimental-strip-types --test backend/tests/governance_security.test.ts backend/tests/api_http.test.ts backend/tests/postgres_repositories.test.ts backend/tests/auth_core.test.ts backend/tests/auth_service.test.ts",
    "test:frontend": "npm test --prefix frontend",
