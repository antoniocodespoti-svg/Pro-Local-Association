    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
